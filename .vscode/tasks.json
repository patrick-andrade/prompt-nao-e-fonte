{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validar contrato (Atividade 0)",
      "detail": "python scripts/validar_contrato.py — só biblioteca padrão; nada a instalar.",
      "type": "shell",
      "command": "python",
      "args": ["scripts/validar_contrato.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Reconstruir CSV em R (--offline)",
      "detail": "Rscript lê o bruto congelado em data/raw/ e reconstrói o CSV contratado.",
      "type": "shell",
      "command": "Rscript",
      "args": ["02-dados-fiscal-monitor/scripts/baixar_fm.R", "--offline"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Preparar ambiente para casa (uv + .venv)",
      "detail": "uv sync --locked — cria o ambiente isolado do projeto; requer uv instalado.",
      "type": "shell",
      "command": "uv",
      "args": ["sync", "--locked"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
